(cx-gui-do cx-activate-item \"Key Behavioral Changes*PanelButtons*PushButton1(OK)\")""")
setup1.SendCommand(Command='(%py-exec "preferences.General.StartupMessages.KeyBehavioralChangesMessage.set_state(True)")')
mesh1.Edit()
mesh1.Edit()
meshComponent1.UpdateUpstreamComponents()
setupComponent1.UpdateUpstreamComponents()
setup1.SendCommand(Command='(cx-gui-do cx-activate-item "MenuBar*FileMenu*Close Fluent")')
mesh1.Edit()
system2.Copy(KeepConnections=True)
system4 = GetSystem(Name="Geom 1")
geometry2 = system4.GetContainer(ComponentName="Geometry")
geometry2.Edit()
parameter2 = Parameters.GetParameter(Name="P3")
designPoint1.SetParameterExpression(
    Parameter=parameter2,
    Expression="20 [degree]")
parameter3 = Parameters.GetParameter(Name="P4")
designPoint1.SetParameterExpression(
    Parameter=parameter3,
    Expression="-20 [degree]")
system1.Copy(KeepConnections=False)
system5 = GetSystem(Name="SYS 1")
geometryComponent1 = system5.GetComponent(Name="Geometry")
geometryComponent2 = system4.GetComponent(Name="Geometry")
geometryComponent1.ReplaceWithShare(
    TargetSystem=system5,
    ComponentToShare=geometryComponent2,
    SourceSystem=system4)
meshComponent2 = system5.GetComponent(Name="Mesh")
meshComponent2.Refresh()
mesh2 = system5.GetContainer(ComponentName="Mesh")
mesh2.Edit()
meshComponent2.Refresh()
mesh2.Edit()
mesh1.Exit()
geometry1.Exit()
meshComponent2.Refresh()
mesh2.Edit()
meshComponent2.Update(AllDependencies=True)
meshComponent2.Update(AllDependencies=True)
template1 = GetTemplate(TemplateName="FLUENT")
system6 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system5)
setupComponent2 = system6.GetComponent(Name="Setup")
meshComponent2.TransferData(TargetComponent=setupComponent2)
setupComponent2.Refresh()
